                        <i b-iwpun16f09 data-lucide="sun" class="w-4 h-4 sm:w-5 sm:h-5 text-amber-400 hidden dark:block"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>
    
    <!-- Community & Bot Links - Side by Side -->
