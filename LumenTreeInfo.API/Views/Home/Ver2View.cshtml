@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>LightEarth Monitor V2</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 500: '#0ea5e9', 600: '#0284c7' }
                    }
                }
            }
        }
    </script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    
    <style>
        * { font-family: 'Inter', sans-serif; }
        
        /* Glassmorphism */
        .glass-card {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        /* PV Circle Animation */
        .pv-circle-animate {
            animation: pv-pulse 2s ease-in-out infinite;
        }
        @@keyframes pv-pulse {
            0%, 100% { filter: drop-shadow(0 0 5px rgba(34, 197, 94, 0.5)); }
            50% { filter: drop-shadow(0 0 15px rgba(34, 197, 94, 0.8)); }
        }
        
        /* Value blink on update */
        .value-updated {
            animation: blink 0.5s ease-in-out;
        }
        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        /* Loading spinner */
        .spinner {
            border: 3px solid rgba(255,255,255,0.3);
            border-top: 3px solid #10b981;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            animation: spin 1s linear infinite;
        }
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* Button styles for mobile */
        .btn-primary {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            transition: all 0.2s ease;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
            user-select: none;
        }
        .btn-primary:active {
            transform: scale(0.95);
        }
        
        .btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.2s ease;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }
        .btn-secondary:active {
            background: rgba(255, 255, 255, 0.2);
        }
        
        /* View toggle buttons */
        .view-btn {
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }
        .view-btn.active {
            background: #10b981;
            color: white;
        }
        .view-btn:not(.active) {
            background: rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.7);
        }
        
        /* Default zoom 90% */
        html { zoom: 0.9; }
    </style>
</head>
<body class="bg-slate-900 text-white min-h-screen">
    <!-- Header -->
    <header class="bg-slate-800/80 backdrop-blur-lg border-b border-slate-700/50 sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <img src="/logo.png" alt="LightEarth" class="w-8 h-8 rounded-lg">
                    <div>
                        <h1 class="text-lg font-bold">
                            <span class="text-emerald-400">LightEarth</span>
                            <span class="text-slate-300 text-sm ml-1">V2</span>
                        </h1>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <div id="connectionStatus" class="flex items-center gap-1.5 bg-slate-700/50 rounded-full px-3 py-1">
                        <div id="statusDot" class="w-2 h-2 rounded-full bg-red-500"></div>
                        <span id="statusText" class="text-xs text-slate-300">Chưa kết nối</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-6">
        <!-- Hero Section - Input Form -->
        <div id="heroSection" class="mb-6">
            <div class="glass-card rounded-2xl p-6 max-w-md mx-auto">
                <h2 class="text-xl font-bold text-center mb-6 text-emerald-400">Giám Sát Năng Lượng</h2>
                
                <!-- Device ID Input -->
                <div class="mb-4">
                    <label class="block text-slate-400 text-xs mb-2">Device ID</label>
                    <input type="text" id="deviceId" placeholder="P250812032"
                           class="w-full px-4 py-3 bg-slate-800/50 border border-slate-600 rounded-xl text-white text-center text-lg font-semibold focus:outline-none focus:border-emerald-500">
                </div>
                
                <!-- Date Input -->
                <div class="mb-6">
                    <label class="block text-slate-400 text-xs mb-2">Ngày</label>
                    <div class="flex items-center gap-2">
                        <button id="prevDayBtn" class="btn-secondary p-3 rounded-xl">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                            </svg>
                        </button>
                        <input type="date" id="dateInput" 
                               class="flex-1 px-4 py-3 bg-slate-800/50 border border-slate-600 rounded-xl text-white text-center focus:outline-none focus:border-emerald-500">
                        <button id="nextDayBtn" class="btn-secondary p-3 rounded-xl">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </button>
                    </div>
                </div>
                
                <!-- Submit Button -->
                <button id="viewBtn" class="btn-primary w-full py-4 rounded-xl font-bold text-lg">
                    Xem Dashboard
                </button>
            </div>
        </div>

        <!-- Dashboard Section (hidden by default) -->
        <div id="dashboardSection" class="hidden">
            <!-- Compact Header -->
            <div class="glass-card rounded-xl p-3 mb-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <img src="/logo.png" alt="" class="w-8 h-8 rounded-lg">
                        <div>
                            <div id="deviceIdDisplay" class="text-sm font-bold text-white">--</div>
                            <div id="dateDisplay" class="text-xs text-slate-400">--</div>
                        </div>
                    </div>
                    <button id="changeDeviceBtn" class="btn-secondary px-3 py-2 rounded-lg text-xs font-medium">
                        Đổi ID
                    </button>
                </div>
            </div>

            <!-- View Toggle Buttons -->
            <div class="flex justify-center gap-2 mb-4">
                <button id="view3DBtn" class="view-btn active">3D Home</button>
                <button id="viewBasicBtn" class="view-btn">Basic</button>
            </div>

            <!-- 3D Home View -->
            <div id="view3D" class="mb-4">
                <div class="glass-card rounded-2xl p-4 max-w-md mx-auto">
                    <!-- 3D House Image with Overlays -->
                    <div class="relative">
                        <img src="/images/3dhome/house-3d-dark.png" alt="3D Solar Home" 
                             class="w-full h-auto object-contain" style="min-height: 280px;">
                        
                        <!-- PV Power Circle (Top Center) -->
                        <div class="absolute top-0 left-1/2 -translate-x-1/2 z-20">
                            <div class="pv-circle-animate">
                                <svg class="w-20 h-20 sm:w-24 sm:h-24" viewBox="0 0 100 100">
                                    <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(34,197,94,0.2)" stroke-width="6"/>
                                    <circle id="pvProgress" cx="50" cy="50" r="45" fill="none" 
                                            stroke="url(#pvGradient)" stroke-width="6" 
                                            stroke-linecap="round" stroke-dasharray="283" stroke-dashoffset="70"
                                            transform="rotate(-90 50 50)"/>
                                    <defs>
                                        <linearGradient id="pvGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" style="stop-color:#22c55e"/>
                                            <stop offset="100%" style="stop-color:#06b6d4"/>
                                        </linearGradient>
                                    </defs>
                                </svg>
                                <div class="absolute inset-0 flex flex-col items-center justify-center">
                                    <span id="pvPower3D" class="text-lg sm:text-xl font-black text-white">--W</span>
                                </div>
                            </div>
                            <div class="text-center mt-1">
                                <span class="text-xs text-emerald-400 font-bold">Nguồn PV</span>
                            </div>
                        </div>
                        
                        <!-- Battery SOC % -->
                        <div class="absolute left-[8%] top-[50%] z-20">
                            <div class="flex items-center gap-1">
                                <div id="batteryStatusIcon" class="hidden">
                                    <svg id="batteryCharging" class="w-4 h-4 text-emerald-400 animate-bounce hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                                    </svg>
                                    <svg id="batteryDischarging" class="w-4 h-4 text-orange-400 animate-bounce hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                                    </svg>
                                </div>
                                <span id="batterySOC3D" class="text-lg sm:text-xl font-black text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]">--%</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Bottom Stats Cards -->
                    <div class="mt-3 grid grid-cols-3 gap-2">
                        <!-- Battery Card -->
                        <div class="glass-card rounded-xl p-3 text-center">
                            <div class="w-10 h-10 mx-auto mb-2 rounded-lg bg-emerald-500/20 flex items-center justify-center border border-emerald-500/50">
                                <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3h6v2H9zM4 5h16a1 1 0 011 1v14a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1z"/>
                                </svg>
                            </div>
                            <div id="batteryPower3D" class="text-lg sm:text-xl font-black text-emerald-400">--W</div>
                            <div class="text-[10px] text-slate-400 mt-1">Pin sạc/xả</div>
                        </div>
                        
                        <!-- Grid EVN Card -->
                        <div class="glass-card rounded-xl p-3 text-center">
                            <div class="w-10 h-10 mx-auto mb-2 rounded-lg bg-purple-500/20 flex items-center justify-center border border-purple-500/50">
                                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                            </div>
                            <div id="gridPower3D" class="text-lg sm:text-xl font-black text-purple-400">--W</div>
                            <div class="text-[10px] text-slate-400 mt-1">Lưới điện EVN</div>
                        </div>
                        
                        <!-- Load Card -->
                        <div class="glass-card rounded-xl p-3 text-center">
                            <div class="w-10 h-10 mx-auto mb-2 rounded-lg bg-cyan-500/20 flex items-center justify-center border border-cyan-500/50">
                                <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                                </svg>
                            </div>
                            <div id="loadPower3D" class="text-lg sm:text-xl font-black text-cyan-400">--W</div>
                            <div class="text-[10px] text-slate-400 mt-1">Tải tiêu thụ</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Basic View (hidden by default) -->
            <div id="viewBasic" class="hidden mb-4">
                <div class="grid grid-cols-2 gap-3 max-w-md mx-auto">
                    <!-- PV -->
                    <div class="glass-card rounded-xl p-4 text-center">
                        <div class="text-emerald-400 text-xs font-medium mb-1">☀️ Sản Lượng PV</div>
                        <div id="pvPowerBasic" class="text-2xl font-black text-white">--W</div>
                    </div>
                    <!-- Battery -->
                    <div class="glass-card rounded-xl p-4 text-center">
                        <div class="text-emerald-400 text-xs font-medium mb-1">🔋 Pin</div>
                        <div id="batteryPowerBasic" class="text-2xl font-black text-white">--W</div>
                        <div id="batterySOCBasic" class="text-sm text-slate-400">--%</div>
                    </div>
                    <!-- Grid -->
                    <div class="glass-card rounded-xl p-4 text-center">
                        <div class="text-purple-400 text-xs font-medium mb-1">⚡ Lưới EVN</div>
                        <div id="gridPowerBasic" class="text-2xl font-black text-white">--W</div>
                    </div>
                    <!-- Load -->
                    <div class="glass-card rounded-xl p-4 text-center">
                        <div class="text-cyan-400 text-xs font-medium mb-1">💡 Tiêu Thụ</div>
                        <div id="loadPowerBasic" class="text-2xl font-black text-white">--W</div>
                    </div>
                </div>
            </div>

            <!-- Summary Stats -->
            <div class="grid grid-cols-3 gap-2 max-w-lg mx-auto mb-4">
                <div class="bg-teal-600/80 rounded-xl p-3 text-center">
                    <div class="text-white/70 text-[10px]">PV Hôm Nay</div>
                    <div id="pvTotal" class="text-sm font-bold text-white">--</div>
                </div>
                <div class="bg-emerald-600/80 rounded-xl p-3 text-center">
                    <div class="text-white/70 text-[10px]">Nạp Pin</div>
                    <div id="chargeTotal" class="text-sm font-bold text-white">--</div>
                </div>
                <div class="bg-indigo-600/80 rounded-xl p-3 text-center">
                    <div class="text-white/70 text-[10px]">Tiêu Thụ</div>
                    <div id="loadTotal" class="text-sm font-bold text-white">--</div>
                </div>
            </div>

            <!-- Loading indicator -->
            <div id="loadingIndicator" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
                <div class="bg-slate-800 rounded-xl p-6 flex flex-col items-center gap-3">
                    <div class="spinner"></div>
                    <span class="text-sm text-slate-300">Đang tải dữ liệu...</span>
                </div>
            </div>
        </div>
    </main>

    <!-- JavaScript -->
    <script src="/js/ver2.js?v=1"></script>
</body>
</html>
