@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Device Management - LightEarth Private</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    
    <style>
        * { font-family: 'Inter', sans-serif; }
        
        .device-card {
            transition: all 0.2s ease;
        }
        
        .device-card:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        }
        
        .status-online {
            background-color: #10b981;
            box-shadow: 0 0 6px #10b981;
        }
        
        .status-offline {
            background-color: #ef4444;
        }
        
        .spinner {
            border: 2px solid rgba(255,255,255,0.1);
            border-left-color: #14b8a6;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            animation: spin 0.8s linear infinite;
        }
        
        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="bg-slate-900 text-gray-100 min-h-screen">
    <!-- Compact Header -->
    <header class="bg-slate-800/80 backdrop-blur border-b border-slate-700 sticky top-0 z-50">
        <div class="max-w-[1800px] mx-auto px-3 py-2">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <img src="/logo.png" alt="LightEarth" class="w-7 h-7 rounded-lg">
                    <span class="text-sm font-bold text-teal-400">Private</span>
                    <span id="deviceCount" class="text-xs text-slate-400 ml-2">--</span>
                </div>
                
                <div class="flex items-center gap-2">
                    <!-- Auto Toggle -->
                    <button id="autoRefreshBtn" onclick="toggleAutoRefresh()" 
                            class="flex items-center gap-1 px-2 py-1 text-xs rounded bg-slate-700 hover:bg-slate-600 transition-colors">
                        <span id="autoText" class="text-slate-400">Auto</span>
                    </button>
                    
                    <!-- Refresh -->
                    <button onclick="loadDevices()" class="p-1.5 bg-teal-600 hover:bg-teal-500 rounded transition-colors">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5" id="refreshIcon"></i>
                    </button>
                    
                    <!-- Home -->
                    <a href="/" class="p-1.5 bg-slate-700 hover:bg-slate-600 rounded transition-colors">
                        <i data-lucide="home" class="w-3.5 h-3.5"></i>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-[1800px] mx-auto px-2 py-3">
        <!-- Loading -->
        <div id="loadingState" class="flex items-center justify-center py-12">
            <div class="spinner"></div>
        </div>
        
        <!-- Error -->
        <div id="errorState" class="hidden text-center py-8">
            <div class="text-red-400 text-sm mb-2" id="errorMessage">Error</div>
            <button onclick="loadDevices()" class="text-xs bg-red-600 hover:bg-red-500 px-3 py-1 rounded">Retry</button>
        </div>
        
        <!-- Empty -->
        <div id="emptyState" class="hidden text-center py-8 text-slate-500 text-sm">
            No devices found
        </div>
        
        <!-- Devices Grid: 4 cols mobile, 8 cols PC -->
        <div id="devicesGrid" class="hidden grid grid-cols-4 lg:grid-cols-8 gap-1.5 sm:gap-2"></div>
        
        <!-- Summary Row -->
        <div id="summarySection" class="hidden mt-3">
            <div class="flex flex-wrap justify-center gap-2 sm:gap-4 text-xs">
                <div class="flex items-center gap-1.5 bg-slate-800/50 px-3 py-1.5 rounded-full">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span class="text-slate-400">PV:</span>
                    <span id="totalPv" class="font-bold text-amber-400">--</span>
                </div>
                <div class="flex items-center gap-1.5 bg-slate-800/50 px-3 py-1.5 rounded-full">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span class="text-slate-400">Pin:</span>
                    <span id="totalBattery" class="font-bold text-emerald-400">--</span>
                </div>
                <div class="flex items-center gap-1.5 bg-slate-800/50 px-3 py-1.5 rounded-full">
                    <span class="w-2 h-2 rounded-full bg-violet-500"></span>
                    <span class="text-slate-400">EVN:</span>
                    <span id="totalGrid" class="font-bold text-violet-400">--</span>
                </div>
                <div class="flex items-center gap-1.5 bg-slate-800/50 px-3 py-1.5 rounded-full">
                    <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                    <span class="text-slate-400">Tải:</span>
                    <span id="totalLoad" class="font-bold text-sky-400">--</span>
                </div>
            </div>
        </div>
    </main>

    <script>
        lucide.createIcons();
        
        let autoRefresh = false;
        let refreshInterval = null;
        
        document.addEventListener('DOMContentLoaded', loadDevices);
        
        function toggleAutoRefresh() {
            autoRefresh = !autoRefresh;
            const btn = document.getElementById('autoRefreshBtn');
            const text = document.getElementById('autoText');
            
            if (autoRefresh) {
                btn.classList.remove('bg-slate-700');
                btn.classList.add('bg-teal-600');
                text.classList.remove('text-slate-400');
                text.classList.add('text-white');
                refreshInterval = setInterval(loadDevices, 10000);
            } else {
                btn.classList.add('bg-slate-700');
                btn.classList.remove('bg-teal-600');
                text.classList.add('text-slate-400');
                text.classList.remove('text-white');
                if (refreshInterval) clearInterval(refreshInterval);
            }
        }
        
        async function loadDevices() {
            const icon = document.getElementById('refreshIcon');
            icon.classList.add('animate-spin');
            
            try {
                const resp = await fetch('/api/ha/devices');
                const data = await resp.json();
                
                document.getElementById('loadingState').classList.add('hidden');
                document.getElementById('errorState').classList.add('hidden');
                document.getElementById('emptyState').classList.add('hidden');
                
                if (!data.success) {
                    document.getElementById('errorState').classList.remove('hidden');
                    document.getElementById('errorMessage').textContent = data.error;
                    return;
                }
                
                if (data.devices.length === 0) {
                    document.getElementById('emptyState').classList.remove('hidden');
                    return;
                }
                
                document.getElementById('deviceCount').textContent = `${data.count} devices`;
                renderDevices(data.devices);
                updateSummary(data.devices);
                
            } catch (e) {
                document.getElementById('loadingState').classList.add('hidden');
                document.getElementById('errorState').classList.remove('hidden');
                document.getElementById('errorMessage').textContent = e.message;
            } finally {
                icon.classList.remove('animate-spin');
            }
        }
        
        function renderDevices(devices) {
            const grid = document.getElementById('devicesGrid');
            grid.classList.remove('hidden');
            document.getElementById('summarySection').classList.remove('hidden');
            
            grid.innerHTML = devices.map(d => createCard(d)).join('');
            lucide.createIcons();
        }
        
        function createCard(d) {
            const on = d.isOnline;
            const rt = d.realtime || {};
            const soc = rt.batterySoc || 0;
            const pv = rt.pvPower || 0;
            const bat = rt.batteryPower || 0;
            const grid = rt.gridPower || 0;
            const load = rt.loadPower || 0;
            
            // Short device ID
            const shortId = d.deviceId.length > 8 ? d.deviceId.slice(-8) : d.deviceId;
            
            // SOC color
            const socColor = soc >= 80 ? 'text-emerald-400' : (soc >= 30 ? 'text-amber-400' : 'text-red-400');
            const socBg = soc >= 80 ? 'bg-emerald-500' : (soc >= 30 ? 'bg-amber-500' : 'bg-red-500');
            
            return `
                <a href="/?deviceId=${d.deviceId}" 
                   class="device-card block bg-slate-800 rounded-lg overflow-hidden border border-slate-700/50 hover:border-teal-500/50">
                    <!-- Header: ID + Status -->
                    <div class="px-2 py-1.5 bg-slate-700/30 flex items-center justify-between">
                        <span class="text-[10px] sm:text-xs font-semibold text-slate-200 truncate">${shortId}</span>
                        <span class="w-1.5 h-1.5 rounded-full flex-shrink-0 ${on ? 'status-online' : 'status-offline'}"></span>
                    </div>
                    
                    ${on ? `
                        <!-- SOC Bar -->
                        <div class="px-2 pt-1.5">
                            <div class="flex items-center justify-between mb-0.5">
                                <span class="text-[9px] text-slate-500">SOC</span>
                                <span class="text-[10px] font-bold ${socColor}">${soc}%</span>
                            </div>
                            <div class="h-1 bg-slate-700 rounded-full overflow-hidden">
                                <div class="${socBg} h-full rounded-full transition-all" style="width:${soc}%"></div>
                            </div>
                        </div>
                        
                        <!-- Power Values -->
                        <div class="p-2 grid grid-cols-2 gap-1">
                            <div class="text-center">
                                <div class="text-[9px] text-amber-500">PV</div>
                                <div class="text-[10px] sm:text-xs font-bold text-amber-400">${formatPw(pv)}</div>
                            </div>
                            <div class="text-center">
                                <div class="text-[9px] ${bat < 0 ? 'text-emerald-500' : 'text-rose-500'}">${bat < 0 ? 'Sạc' : 'Xả'}</div>
                                <div class="text-[10px] sm:text-xs font-bold ${bat < 0 ? 'text-emerald-400' : 'text-rose-400'}">${formatPw(Math.abs(bat))}</div>
                            </div>
                            <div class="text-center">
                                <div class="text-[9px] text-violet-500">EVN</div>
                                <div class="text-[10px] sm:text-xs font-bold text-violet-400">${formatPw(Math.abs(grid))}</div>
                            </div>
                            <div class="text-center">
                                <div class="text-[9px] text-sky-500">Tải</div>
                                <div class="text-[10px] sm:text-xs font-bold text-sky-400">${formatPw(load)}</div>
                            </div>
                        </div>
                    ` : `
                        <div class="p-3 text-center">
                            <i data-lucide="wifi-off" class="w-5 h-5 text-slate-600 mx-auto"></i>
                            <div class="text-[10px] text-slate-500 mt-1">Offline</div>
                        </div>
                    `}
                </a>
            `;
        }
        
        function formatPw(v) {
            if (v == null) return '--';
            if (v >= 1000) return (v/1000).toFixed(1) + 'k';
            return v + '';
        }
        
        function updateSummary(devices) {
            let pv = 0, bat = 0, grid = 0, load = 0;
            devices.forEach(d => {
                if (d.isOnline && d.realtime) {
                    pv += d.realtime.pvPower || 0;
                    bat += d.realtime.batteryPower || 0;
                    grid += d.realtime.gridPower || 0;
                    load += d.realtime.loadPower || 0;
                }
            });
            
            document.getElementById('totalPv').textContent = formatPw(pv) + 'W';
            document.getElementById('totalBattery').textContent = formatPw(Math.abs(bat)) + 'W';
            document.getElementById('totalGrid').textContent = formatPw(Math.abs(grid)) + 'W';
            document.getElementById('totalLoad').textContent = formatPw(load) + 'W';
        }
    </script>
</body>
</html>
